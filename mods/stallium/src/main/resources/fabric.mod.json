{
	"schemaVersion": 1,
	"id": "stallium",
	"version": "${version}",
	"name": "Stallium",
	"description": "Horse stats at a glance: stat bars above horses, best-horse glow, breeding pair hints and foal growth timers.",
	"authors": [
		"Kraineff"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/stallium"
	},
	"license": "MIT",
	"icon": "assets/stallium/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.kraineff.stallium.StalliumClient"
		],
		"modmenu": [
			"com.kraineff.stallium.config.StalliumModMenu"
		]
	},
	"mixins": [
		{
			"config": "stallium.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "${minecraft_range}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/stallium"
			}
		}
	}
}
